<article class="project-card-container" data-tags="{{ p.tags_raw | default('') }}" data-href="{{ p.href }}" aria-label="{{ p.title }}">
  <div class="project-card">
    <div class="project-card__face project-card__face--front">
      <img class="project-card__image" src="{{ p.img }}" alt="{{ p.alt | default(p.title) }}" loading="lazy" decoding="async">
      <div class="project-card__shade" aria-hidden="true"></div>
      <div class="project-card__front-copy">
        <p class="project-card__year">{{ p.year | default('Selected work') }}</p>
        <h3 class="project-card__title" data-i18n="projects.{{ id }}.title">{{ p.title }}</h3>
        <p class="project-card__hint" data-i18n="projectCard.hint">Click to view</p>
      </div>
    </div>

    <div class="project-card__face project-card__face--back">
      <div class="project-card__back-copy">
        <div class="project-card__back-head">
          <p class="project-card__kicker" data-i18n="projectCard.glance">At a glance</p>
          <p class="project-card__back-title" data-i18n="projects.{{ id }}.title">{{ p.title }}</p>
        </div>

        <p class="project-card__desc" data-i18n="projects.{{ id }}.desc">{{ p.desc }}</p>

        {% if p.specs and p.specs.length %}
          <ul class="project-card__specs" aria-label="Project highlights">
            {% for spec in p.specs %}
              {% if loop.index <= 3 %}
                <li data-i18n="projects.{{ id }}.specs.{{ loop.index0 }}">{{ spec }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% elif p.chips and p.chips.length %}
          <div class="project-card__meta" aria-label="Project topics">
            {% for c in p.chips %}
              {% if loop.index <= 3 %}
                <span class="chip">{{ c }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <a class="project-card__btn" href="{{ p.href }}" aria-label="View project: {{ p.title }}" data-i18n="projectCard.view">View project</a>
      </div>
    </div>
  </div>
</article>
