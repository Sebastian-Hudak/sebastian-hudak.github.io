<!DOCTYPE html>
<html lang="en">
<head>
  {% set pageKey = page.fileSlug or ("index" if page.url == "/" else "") %}
  {% set pageSeo = seo[pageKey] if seo and seo[pageKey] else {} %}
  {% set pageI18n = i18n.pages[pageKey] if i18n and i18n.pages and i18n.pages[pageKey] else {} %}
  {% set metaTitle = pageSeo.metaTitle or title or site.title %}
  {% set metaDescription = pageSeo.description or site.description %}
  {% set metaKeywords = pageSeo.keywords or site.defaultKeywords %}
  {% set metaImage = pageSeo.image or site.defaultImage %}
  {% set metaImageUrl = metaImage if metaImage and metaImage[0] != "/" else site.url + metaImage %}
  {% set metaImageWidth = pageSeo.imageWidth or (site.defaultImageWidth if not pageSeo.image else null) %}
  {% set metaImageHeight = pageSeo.imageHeight or (site.defaultImageHeight if not pageSeo.image else null) %}
  {% set metaImageType = pageSeo.imageType or (site.defaultImageType if not pageSeo.image else null) %}
  {% set canonicalUrl = site.url + page.url %}
  {% set ogType = pageSeo.type or ("website" if pageKey == "index" else "article") %}
  {% set searchIndexingEnabled = site.searchIndexingEnabled != false %}
  {% set robotsDirectives = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" if searchIndexingEnabled else "noindex,nofollow,noarchive,noimageindex,nosnippet,max-image-preview:none" %}
  {% set siteLogo = site.logo if site.logo and site.logo[0] != "/" else site.url + site.logo %}

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ metaDescription }}">
  <meta name="keywords" content="{{ metaKeywords }}">
  <meta name="author" content="{{ site.shortName }}">
  <meta name="robots" content="{{ robotsDirectives }}">
  <meta name="googlebot" content="{{ robotsDirectives }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f7f5f1">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <title>{% if pageKey == "index" %}{{ metaTitle }} | {{ site.shortName }}{% else %}{{ metaTitle }} | {{ site.shortName }}{% endif %}</title>
  <link rel="canonical" href="{{ canonicalUrl }}">
  {% if searchIndexingEnabled %}
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
  {% endif %}

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="de_DE">
  <meta property="og:locale:alternate" content="sk_SK">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ metaImageUrl }}">
  <meta property="og:image:secure_url" content="{{ metaImageUrl }}">
  <meta property="og:image:alt" content="{{ pageSeo.imageAlt or metaTitle }}">
  {% if metaImageWidth %}<meta property="og:image:width" content="{{ metaImageWidth }}">{% endif %}
  {% if metaImageHeight %}<meta property="og:image:height" content="{{ metaImageHeight }}">{% endif %}
  {% if metaImageType %}<meta property="og:image:type" content="{{ metaImageType }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="{{ metaImageUrl }}">
  <meta name="twitter:image:alt" content="{{ pageSeo.imageAlt or metaTitle }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script>
    (function () {
      try {
        const storedTheme = localStorage.getItem("site-theme");
        const storedLanguage = localStorage.getItem("site-language");
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = storedTheme || systemTheme;

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;

        if (storedLanguage) {
          document.documentElement.lang = storedLanguage;
          document.documentElement.dataset.language = storedLanguage;
        }
      } catch (error) {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>
  
  <link rel="stylesheet" href="/assets/css/main.css" />

  {% if searchIndexingEnabled %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "{{ "ProfilePage" if pageKey == "index" else "WebPage" }}",
        "@id": {{ (canonicalUrl + "#webpage") | json | safe }},
        "url": {{ canonicalUrl | json | safe }},
        "name": {{ metaTitle | json | safe }},
        "description": {{ metaDescription | json | safe }},
        "inLanguage": {{ site.defaultLocale | json | safe }},
        "image": {
          "@type": "ImageObject",
          "url": {{ metaImageUrl | json | safe }}{% if metaImageWidth %},
          "width": {{ metaImageWidth }}{% endif %}{% if metaImageHeight %},
          "height": {{ metaImageHeight }}{% endif %}
        },
        "isPartOf": {
          "@type": "WebSite",
          "@id": {{ (site.url + "/#website") | json | safe }},
          "url": {{ (site.url + "/") | json | safe }},
          "name": {{ site.title | json | safe }},
          "publisher": {
            "@id": {{ (site.url + "/#person") | json | safe }}
          }
        },
        "author": {
          "@id": {{ (site.url + "/#person") | json | safe }}
        }
      }
    </script>
    {% if pageKey == "index" %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": {{ (site.url + "/#website") | json | safe }},
          "url": {{ (site.url + "/") | json | safe }},
          "name": {{ site.title | json | safe }},
          "description": {{ site.description | json | safe }},
          "inLanguage": {{ site.defaultLocale | json | safe }},
          "publisher": {
            "@id": {{ (site.url + "/#person") | json | safe }}
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "@id": {{ (site.url + "/#person") | json | safe }},
          "name": {{ site.name | json | safe }},
          "url": {{ site.url | json | safe }},
          "image": {{ (site.url + "/assets/images/page/sebastian-hudak-portrait.png") | json | safe }},
          "logo": {{ siteLogo | json | safe }},
          "jobTitle": "Aerospace Engineer",
          "knowsAbout": {{ site.knowsAbout | json | safe }},
          "sameAs": {{ site.sameAs | json | safe }}
        }
      </script>
    {% endif %}
  {% endif %}

  {% if headExtra %}{{ headExtra | safe }}{% endif %}
</head>

<body data-page-key="{{ pageKey }}">
  {% include "partials/header.html" %}

  <main class="{{ mainClass | default('page') }}">
    {{ content | safe }}
  </main>

  {% include "partials/footer.html" %}
  <script id="i18n-shared" type="application/json">{{ i18n.shared | json | safe }}</script>
  <script id="i18n-page" type="application/json">{{ pageI18n | json | safe }}</script>
  {% include "partials/scripts.html" %}
</body>
</html>
